# ─────────────────────────────────────────────────────────────────────────────
# TraceGraph — environment variables (reference)
#
# Copy the relevant block into the per-app .env files listed below.
# NEVER commit real credentials. The .env files are gitignored.
#
#   apps/api/.env       → backend (NestJS)
#   apps/web/.env.local → frontend (Next.js)
# ─────────────────────────────────────────────────────────────────────────────

# ── apps/api/.env ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGIN=http://localhost:3000
# CognoDB (Bolt). Example: bolt+s://<host>.databases.cognodb.com:7687
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
# Connection retry behavior at startup (optional, sensible defaults).
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_MS=500
# Driver connection timeout (ms) — hard bound, no infinite waits.
DB_CONNECT_TIMEOUT_MS=5000
# Safety-net query timeout (ms). 0 disables.
DB_QUERY_TIMEOUT_MS=10000
LOG_LEVEL=info

# ── apps/web/.env.local ───────────────────────────────────────────────────────
# Base URL of the NestJS backend (browser-facing, safe to expose).
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Canonical origin of the deployed app — used as metadataBase for share images.
NEXT_PUBLIC_APP_URL=http://localhost:3000

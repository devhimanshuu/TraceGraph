# apps/api/.env  (never commit real credentials)
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (no wildcards).
CORS_ORIGIN=http://localhost:3000
# CognoDB (Bolt). Example: bolt+s://<host>.databases.cognodb.com:7687
COGNODB_URI=
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=
# Startup connectivity retries before entering degraded mode.
DB_CONNECT_RETRIES=3
DB_CONNECT_RETRY_DELAY_MS=500
# Driver connection timeout (ms) — hard bound, no infinite waits.
DB_CONNECT_TIMEOUT_MS=5000
# Safety-net query timeout (ms). 0 disables.
DB_QUERY_TIMEOUT_MS=10000
LOG_LEVEL=info
# GitHub OAuth App credentials (github.com/settings/developers -> New OAuth App).
# Homepage URL: http://localhost:3000
# Authorization callback URL: http://localhost:4000/api/auth/github/callback
# When absent, the auth entry degrades to a readable redirect and every
# protected endpoint fails closed with 401.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/github/callback
# HMAC secret signing TraceGraph's own session tokens (shared with apps/web
# so the proxy.ts middleware can verify route access). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_TTL_DAYS=7
WEB_APP_URL=http://localhost:3000

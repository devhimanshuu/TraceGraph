# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the NestJS backend. Local dev default; must be set in production.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── App ──────────────────────────────────────────────────────────────────────
# Canonical origin of the deployed web app. Used as the metadataBase for
# OpenGraph/social share images. Local dev default; set the deployed URL in
# production (e.g. https://tracegraph.example.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000
